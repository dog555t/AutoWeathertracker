[Unit]
Description=In-Car AQI Monitor Web Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/AutoWeathertracker
Environment="PATH=/home/pi/AutoWeathertracker/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_HOST=0.0.0.0"
Environment="FLASK_PORT=5000"
ExecStart=/home/pi/AutoWeathertracker/venv/bin/python3 /home/pi/AutoWeathertracker/web_app.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
